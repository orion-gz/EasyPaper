OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
MAX_FILE_SIZE_MB=50
SESSION_TTL_HOURS=24
# 인증 사용자별 고비용 API 제한(프로세스별 슬라이딩 윈도우)
CHAT_RATE_LIMIT_REQUESTS=30
TRANSLATE_RATE_LIMIT_REQUESTS=120
UPLOAD_RATE_LIMIT_REQUESTS=10
UPLOAD_DIR=./uploads
CACHE_DIR=./cache
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# 기본 사용자 설정 (처음 시작 시 아이디: admin, 비밀번호: admin)
# 로그인 후 설정 화면에서 비밀번호를 변경하면 자동으로 .env에 해시값이 저장됩니다.
# APP_USERNAME=admin
# SECRET_KEY=generate_some_random_secret_key_here

# API 제공업체 설정
TRANS_PROVIDER=ollama
TRANS_MODEL=gemma4:e4b
CHAT_PROVIDER=ollama
CHAT_MODEL=gemma4:e4b
# 비워두면 기존 번역 설정을 기본 AI 모델로 사용합니다.
DEFAULT_AI_PROVIDER=
DEFAULT_AI_MODEL=
# 비워두면 각각 CHAT, ANALYSIS 설정을 순서대로 상속합니다.
ANALYSIS_PROVIDER=
ANALYSIS_MODEL=
LIBRARY_PROVIDER=
LIBRARY_MODEL=

# 외부 API 키 설정 (필요에 따라 작성)
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=

# 참고문헌 링크 연결(OpenAlex) 설정 - 가입/키 자체가 필요 없어 비워둬도 정상
# 동작하지만, 연락 가능한 이메일을 적어두면 더 여유로운 한도의 "polite pool"을
# 적용받습니다.
OPENALEX_MAILTO=

# 서비스 구동 호스트 및 포트 설정
APP_HOST=0.0.0.0
APP_PORT=8000

# Antigravity CLI (agy) 절대 경로 설정 (선택 사항 - 비워두면 PATH에서 자동으로 찾음)
# AGY_PATH=/path/to/agy

# 프로젝트 루트 절대 경로 설정 (선택 사항 - 비워두면 자동으로 감지됨)
# PROJECT_ROOT=/path/to/EasyPaper
