[Unit]
Description=EasyPaper Lab application
After=network-online.target easypaper-lab-runner.service

[Service]
Type=simple
User=easypaper
Group=easypaper
WorkingDirectory=/opt/easypaper/backend
Environment=EASYPAPER_CONFIG_DIR=/var/lib/easypaper
Environment=EASYPAPER_LOG_DIR=/var/lib/easypaper/logs
Environment=DB_PATH=/var/lib/easypaper/easypaper.db
Environment=UPLOAD_DIR=/var/lib/easypaper/uploads
Environment=LIBRARY_DIR=/var/lib/easypaper/library
Environment=CACHE_DIR=/var/lib/easypaper/cache
Environment=EASYPAPER_LAB_RUNNER_SOCKET=/run/easypaper-lab/runner.sock
Environment=APP_HOST=127.0.0.1
ExecStart=/opt/easypaper/venv/bin/python /opt/easypaper/backend/main.py
StateDirectory=easypaper
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/easypaper
Restart=on-failure

[Install]
WantedBy=multi-user.target
