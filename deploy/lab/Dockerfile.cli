# Build one pinned provider image per CLI; no credentials are baked into images.
FROM node:22-bookworm-slim
ARG CLI_PACKAGE
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates python3 \
    && rm -rf /var/lib/apt/lists/* \
    && test -n "$CLI_PACKAGE" && npm install --global "$CLI_PACKAGE" \
    && npm cache clean --force \
    && mkdir -p /home/user
ENV HOME=/home/user
WORKDIR /home/user
